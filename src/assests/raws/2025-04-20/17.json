ed_info":"Cj4I3dCdgNDYrOowEAMaCDc2MTM5NTg0IPW/n48GMAA4V0AVcgk1MTIzNjA3NTZ4AKoBCWJpbGxib2FyZNIBAA==","detail_text":"52 万热度","trend":0,"debut":false,"children":[{"type":"answer","thumbnail":"https://pic1.zhimg.com/v2-aeb35a2af71dfe4cd2bd8d3810b28642_1440w.png?source=7e7ef6e2&needBackground=1"}]},{"type":"hot_list_feed","style_type":"1","id":"22_1745140752.12259","card_id":"Q_445369653","target":{"id":445369653,"title":"为什么保罗·马尔蒂尼被公认为历史第一左后卫？","url":"https://api.zhihu.com/questions/445369653","type":"question","created":1613795306,"answer_count":82,"follower_count":156,"author":{"type":"people","user_type":"people","id":"0","url_token":"","url":"","name":"用户","headline":"","avatar_url":"https://pica.zhimg.com/aadd7b895_s.jpg"},"bound_topic_ids":[833,1538,2955,35873],"comment_count":0,"is_following":false,"excerpt":""},"attached_info":"Cj8I3dCdgNDYrOowEAMaCDYxMjQ5NzcyIOqfwoEGMAA4nAFAFnIJNDQ1MzY5NjUzeACqAQliaWxsYm9hcmTSAQA=","detail_text":"49 万热度","trend":0,"debut":false,"children":[{"type":"answer","thumbnail":"https://pic3.zhimg.com/50/v2-39eefce92bbafac50f70ca770c702b70_b.jpg"}]},{"type":"hot_list_feed","style_type":"1","id":"23_1745140752.12508","card_id":"Q_1896941503760277510","target":{"id":1896941503760277500,"title":"董宇辉获得人民文学奖的传播贡献奖，他对文学传播做出了哪些贡献？","url":"https://api.zhihu.com/questions/1896941503760277510","type":"question","created":1745046097,"answer_count":223,"follower_count":322,"author":{"type":"people","user_type":"people","id":"0","url_token":"","url":"","name":"用户","headline":"","avatar_url":"https://pica.zhimg.com/aadd7b895_s.jpg"},"bound_topic_ids":[2058,13322,132249,2065836,3206828],"comment_count":0,"is_following":false,"excerpt":"4月19日，2024年度青花郎·人民文学奖颁奖典礼在四川古蔺郎酒庄园举行。 据中国作家网消息，今年的奖项有颇多新意：长篇小说奖中增设长篇致敬奖，特殊文体奖授予了科幻题材的剧本，以及颁发与时俱进的“传播贡献奖”。 报道显示，传播贡献奖由董宇辉获得，“他将文学一次次推向读者，唤起了无数热爱文学的人的内心热望。” 青花郎·人民文学奖是由《人民文学》杂志社与郎酒集团合作主办的《人民文学》年度奖，每年颁发一次，评选范围为该年度在《人民文学》杂志上刊发的优秀作品，以及该年度为《人民文学》中文版和外文版作出巨大贡献的作家与专家。 青花郎·人民文学奖是文学界有重要口碑和影响的文学大奖，得到了全社会的关注。人民文学奖评奖程序严谨、科学，公信力权威性强，所评作品有很高的思想艺术水平，为中国当代文学的繁荣和文学评奖生态的建立作出了积极的探索和有益的贡献。 此次，柳青《在旷野里》获长篇致敬奖，刘醒龙《听漏》获长篇小说奖；蔡崇达《命运慢跑团》、陈集益《出燕郊》获中篇小说奖；林那北《春江水很暖》、沈念《寤生》获短篇小说奖；姜明《八千年的凝视》、吴志良《遇见》获散文奖；陈人杰《喜马拉雅》、薄暮《冶铁者》获诗歌奖；丁晓平《寻找蒋宗英》获非虚构作品奖；尹迪、吴岩、陈跃红《云身》（剧本）获特殊文体奖；李琸（散文《我有一片戈壁》）、陈小手（短篇小说《夜神的礼物》）获新人奖；莉亚娜获翻译贡献奖，梁平获特别奖，董宇辉获传播贡献奖。 报道称，在文学的旷野里，董宇辉长于发现、敏于共情、精于表达，如同一个信使，尽情释放着文学的魅力与光华。他将文学一次次推向读者，唤起了无数热爱文学的人的内心热望。 2024年1月23日、2024年12月20日，董宇辉以直播间为舞台，助力创刊七十五年的《人民文学》杂志积极融入现代传播格局，以“寻亲”之名，实现与广大读者的“双向奔赴”。这是传播模式的革新，更是对文学生命力的坚定守护。这也深刻证明，优质内容与创新形式的充分融合，一定能让文学在喧嚣时代持续奏响美妙的乐章。 有鉴于此，特授予董宇辉2024年度青花郎·人民文学奖传播贡献奖。 2024年12月，“在文学的旷野里”特别直播活动现场。长安街知事注意到，2024年1月23日晚，《人民文学》首次来到董宇辉直播间，在4个小时内获得上亿次点赞，达成近百万册订阅量。 2024年12月20日，《人民文学》再一次来到董宇辉直播间。主编施战军，作家莫言、梁晓声，以及4位读者代表与董宇辉一起，畅谈文学带给我们的“感知幸福的能力”。 当晚的直播全程约2小时，累计700多万观众观看，最高在线人数27.8万人，2025年全年12期的《人民文学》杂志共售出2.9万套。董宇辉，获《人民文学》年度奖"},"attached_info":"CkoI3dCdgNDYrOowEAMaCTExNDU3ODYzNCDRlI3ABjAAOMICQBdyEzE4OTY5NDE1MDM3NjAyNzc1MTB4AKoBCWJpbGxib2FyZNIBAA==","detail_text":"43 万热度","trend":0,"debut":false,"children":[{"type":"answer","thumbnail":"https://pic1.zhimg.com/80/v2-30702b20a104a801d3cd0c7dbbeca740_1440w.webp?source=1def8aca"}]},{"type":"hot_list_feed","style_type":"1","id":"24_1745140752.14092","card_id":"Q_380949729","target":{"id":380949729,"title":"一架战斗机的体积可以有多大？","url":"https://api.zhihu.com/questions/380949729","type":"question","created":1584669103,"answer_count":49,"follower_count":131,"author":{"type":"people","user_type":"people","id":"0","url_token":"","url":"","name":"用户","headline":"","avatar_url":"https://pica.zhimg.com/aadd7b895_s.jpg"},"bound_topic_ids":[20609,21202,158771],"comment_count":0,"is_following":false,"excerpt":""},"attached_info":"Cj8I3dCdgNDYrOowEAMaCDQ2OTMzNzQ2IK/D0PMFMAA4gwFAGHIJMzgwOTQ5NzI5eACqAQliaWxsYm9hcmTSAQA=","detail_text":"41 万热度","trend":0,"debut":false,"children":[{"type":"answer","thumbnail":"https://pic2.zhimg.com/50/v2-2040aa7af7cd9340190e03e1ca1debad_b.jpg"}]},{"type":"hot_list_feed","style_type":"1","id":"25_1745140752.14340","card_id":"Q_1896157251867244284",