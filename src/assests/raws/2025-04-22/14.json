kvHzx88REAMaCTExNDYwNDg5NyCk3ZbABjAAOKUCQA5yEzE4OTc1OTg5ODEyMjEwOTM2NzF4AKoBCWJpbGxib2FyZNIBAA==","detail_text":"96 万热度","trend":0,"debut":false,"children":[{"type":"answer","thumbnail":"https://pic1.zhimg.com/v2-80f9de2e7a4cc4d264474ef25578d68c_1440w.jpg"}]},{"type":"hot_list_feed","style_type":"1","id":"15_1745303127.691838","card_id":"Q_1897681645231911697","card_label":{"type":"new","icon":"https://pic2.zhimg.com/80/v2-a4b0b52b561281109c51e4957cb20130_1440w.png","night_icon":"https://pic3.zhimg.com/80/v2-10ef6526c602e55a8c606e46aa0cc586_1440w.png"},"target":{"id":1897681645231911700,"title":"LPL 2025 赛季第二赛段组内赛JDG 1:2 WBG，如何评价这场比赛？","url":"https://api.zhihu.com/questions/1897681645231911697","type":"question","created":1745222561,"answer_count":15,"follower_count":13,"author":{"type":"people","user_type":"people","id":"0","url_token":"","url":"","name":"用户","headline":"","avatar_url":"https://pica.zhimg.com/aadd7b895_s.jpg"},"bound_topic_ids":[18427,136272,221226,221298,3822729],"comment_count":0,"is_following":false,"excerpt":""},"attached_info":"CkkIr7nMkvHzx88REAMaCTExNDYxMDYzMyCh95fABjAAOA1AD3ITMTg5NzY4MTY0NTIzMTkxMTY5N3gAqgEJYmlsbGJvYXJk0gEA","detail_text":"92 万热度","trend":0,"debut":true,"children":[{"type":"answer","thumbnail":"https://pic3.zhimg.com/50/v2-1169c9a737818135d19f643e8ff5ae24_b.jpg"}]},{"type":"hot_list_feed","style_type":"1","id":"16_1745303127.692102","card_id":"Q_1897611084057264931","target":{"id":1897611084057265000,"title":"日本将耗资 996 亿打造全球最大驱逐舰，为何建造成本如此高昂？该舰预计将于何时建造完成？","url":"https://api.zhihu.com/questions/1897611084057264931","type":"question","created":1745205738,"answer_count":216,"follower_count":441,"author":{"type":"people","user_type":"people","id":"0","url_token":"","url":"","name":"用户","headline":"","avatar_url":"https://pica.zhimg.com/aadd7b895_s.jpg"},"bound_topic_ids":[229,18146,60069,130159,2001355],"comment_count":0,"is_following":false,"excerpt":"枢密院十号消息，日本共同社18日称，日本防卫相中谷元透露，日本将为2艘全新建造的“宙斯盾系统搭载舰” （ASEV）耗费1.9416万亿日元（约合人民币996亿元）的天价。根据此前透露的信息，作为未来日本海基反导的核心力量，该舰满载排水量超过1.4万吨，配备有128个垂直发射单元，号称是全球最大的驱逐舰。 共同社称，根据中谷元的说法，这两艘驱逐舰1.9416万亿日元覆盖了40年的全寿命周期，包括构想、研究开发、量产部署、使用维护和报废的各个阶段，其中建造费约7800亿日元（约合人民币390亿元）、燃料和维修等维护费约1.07万亿日元等，与其他舰艇相比较“成本合理”。 外界好奇的是，这个天价成本真的“合理”吗？ 不妨先从该舰的来历说起。日本政府2020年宣布取消部署“陆基宙斯盾系统”计划，作为替代，建造了两艘“宙斯盾系统搭载舰”，它们计划分别于2027年度和2028年度开始服役。对于该舰的具体性能，日本方面的说法也几经变迁，早先称宣布该舰排水量将超过惊人的2万吨，甚至考虑过采用前卫的三体船设计，但最终仍选择了相对保守的方案。 美国“海军”新闻网站此前透露，在今年3月阿布扎比举行的IDEX 25展会上，美国洛克希德·马丁公司首次展示了日本正在研发的这种“宙斯盾系统搭载舰”的模型和详细数据——要问为什么是美国公司公布数据？因为该舰的核心——新一代AN/SPY-7有源相控阵雷达就是洛克希德·马丁公司的产品，整舰基本就是围绕这部雷达展开设计，因此洛克希德·马丁公司公布的数据被认为具备相当可信度。 内容来源日本天价打造“全球最大驱逐舰”_日元_成本_美国"},"attached_info":"CkoIr7nMkvHzx88REAMaCTExNDYwNTgyMCDq85bABjAAOLkDQBByEzE4OTc2MTEwODQwNTcyNjQ5MzF4AKoBCWJpbGxib2FyZNIBAA==","detail_text":"86 万热度","trend":0,"debut":false,"children":[{"type":"answer","thumbnail":"https://pic2.zhimg.com/v2-00a8184e9529510e9ec340acd4be23b5_1440w.jpg"}]},{"type":"hot_list_feed","style_type":"1","id":"17_1745303127.693496","card_id":"Q_1894696746149462019","target":{"id":1894696746149462000,"title":"如果让李白、苏轼、李清照组队春游，谁会最先被踢出群聊？","url":"https://api.zhihu.com/questions/1894696746149462019","type":"question","created":1744510906,"answer_count":66,"follower_count":86,"author":{"type":"people","user_type":"people","id":"0","url_token":"","url":"","name":"用户","headline":"","avatar_url":"https://pica.zhimg.com/aadd7b895_s.jpg"},"bound_topic_ids":[3904557],"comment_count":0,"is_following":false,"excerpt":"我觉得是李清照，全程吐槽\"这次第，怎一个愁字了得\"，破坏春游气氛，哈哈哈哈哈"},"attached_info":"CkkIr7nMkvHzx88REAMaCTExNDQ3MTgzMSC6v+y/BjAAOFZAEXITMTg5NDY5Njc0NjE0OTQ2MjAxOXgAqgEJYmlsbGJvYXJk0gEA","detail_text":"81 万热度","trend":0,"debut":false,"children":[{"type":"answer","thumbnail":"https://pic1.zhimg.com/80/v2-e5ae068ce867bb90523a7de52ec28cef_1440w.jpg"}]},{"type":"hot_list_feed","style_type":"1","id":"18_1745303127.694018","card_id":"Q_371231749","card_label":{"type":"new","icon":"https://pic2.zhimg.com/80/v2-a4b0b52b561281109c51e4957cb20130_1440w.png","night_icon":"https://pic3.